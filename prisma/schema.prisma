generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── Semester ───────────────────────────────────────────────
// Top-level container for an academic term.
model Semester {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id")
  name          String        // e.g. "Fall 2026"
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  gradingScale GradingScale @default(ten_point) @map("grading_scale")
  isActive     Boolean      @default(false) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  courses                Course[]
  gradingConfigs         GradingConfig[]
  attendanceMarksConfigs AttendanceMarksConfig[]
  files                  FileAttachment[]
  documentFolders        DocumentFolder[]

  @@index([userId])
  @@map("semesters")
}

enum GradingScale {
  ten_point
  four_point
}

enum AttendanceMode {
  auto // compute from AttendanceRecord rows
  manual // use manualPresent / manualTotalClasses
}

// ─── Course ─────────────────────────────────────────────────
// A single course within a semester.
model Course {
  id                 String          @id @default(uuid())
  semesterId         String          @map("semester_id")
  name               String
  code               String? // e.g. "CS301"
  credits            Int // used in SGPA/CGPA weighting
  instructor         String?
  color              String? // for calendar/UI tagging
  targetGrade        String?         @map("target_grade") // aspirational grade
  attendanceMode     AttendanceMode? @default(auto) @map("attendance_mode")
  manualPresent      Int?            @map("manual_present") // classes attended (manual mode)
  manualTotalClasses Int?            @map("manual_total_classes") // total classes held (manual mode)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  semester               Semester                @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  classSchedules         ClassSchedule[]
  attendanceRecords      AttendanceRecord[]
  assessments            Assessment[]
  tasks                  Task[]
  notes                  Note[]
  gradingConfigs         GradingConfig[]
  attendanceMarksConfigs AttendanceMarksConfig[]
  files                  FileAttachment[]
  documentFolders        DocumentFolder[]

  @@map("courses")
}

// ─── Class Schedule ────────────────────────────────────────
// Recurring weekly time slots for a course.
model ClassSchedule {
  id                 String     @id @default(uuid())
  courseId           String     @map("course_id")
  dayOfWeek          DayOfWeek  @map("day_of_week")
  startTime          String     @map("start_time") // "HH:mm" format
  endTime            String     @map("end_time") // "HH:mm" format
  location           String?
  effectiveStartDate DateTime?  @map("effective_start_date") // null = always active
  effectiveEndDate   DateTime?  @map("effective_end_date")   // null = no end

  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exceptions        ScheduleException[]
  attendanceRecords AttendanceRecord[]

  @@map("class_schedules")
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// ─── Schedule Exception ─────────────────────────────────────
// Single-occurrence deviation from a recurring ClassSchedule.
enum ScheduleExceptionType {
  cancelled
  rescheduled
}

model ScheduleException {
  id              String                 @id @default(uuid())
  classScheduleId String                 @map("class_schedule_id")
  date            DateTime               @db.Date
  type            ScheduleExceptionType
  newStartTime    String?                @map("new_start_time") // only for rescheduled
  newEndTime      String?                @map("new_end_time")   // only for rescheduled
  newLocation     String?                @map("new_location")   // only for rescheduled
  createdAt       DateTime               @default(now()) @map("created_at")

  classSchedule ClassSchedule @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)

  @@unique([classScheduleId, date])
  @@index([classScheduleId])
  @@map("schedule_exceptions")
}

// ─── Attendance Record ─────────────────────────────────────
// One row per actual class occurrence.
model AttendanceRecord {
  id              String           @id @default(uuid())
  courseId        String           @map("course_id")
  classScheduleId String?          @map("class_schedule_id")
  date            DateTime         @db.Date
  status          AttendanceStatus @default(not_marked)

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classSchedule ClassSchedule? @relation(fields: [classScheduleId], references: [id], onDelete: SetNull)

  @@unique([classScheduleId, date])
  @@index([classScheduleId])
  @@index([courseId, date])
  @@map("attendance_records")
}

enum AttendanceStatus {
  present
  absent
  cancelled
  not_marked
}

// ─── Assessment ────────────────────────────────────────────
// A gradable component within a course (minor, mid-sem, end-sem).
model Assessment {
  id            String         @id @default(uuid())
  courseId      String         @map("course_id")
  componentType AssessmentType @map("component_type")
  maxMarks      Int            @map("max_marks")
  obtainedMarks Int?           @map("obtained_marks") // null until graded
  date          DateTime?      @db.Date

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

enum AssessmentType {
  minor_assignment // Minor + Assignment component (max 15 typically)
  attendance // Auto-calculated from attendance records (max 5)
  mid_sem // Mid-semester exam (max 30)
  end_sem // End-semester exam (max 50)
}

// ─── Grading Config ────────────────────────────────────────
// Editable marks-to-grade-point conversion table per course.
// Default: 90-100=10, 80-89=9, 70-79=8, 60-69=7, 50-59=6, 40-49=5, <40=0
model GradingConfig {
  id         String  @id @default(uuid())
  courseId   String? @map("course_id")
  semesterId String? @map("semester_id")
  minPercent Float   @map("min_percent") // e.g. 90.0
  gradePoint Int     @map("grade_point") // e.g. 10

  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@map("grading_configs")
}

// ─── Attendance Marks Config ────────────────────────────────
// Editable attendance-percentage-to-marks table per course.
// Default: ≥95%→5, 90-94.99%→3, 85-89.99%→2, 80-84.99%→1, <80%→0
model AttendanceMarksConfig {
  id         String  @id @default(uuid())
  courseId   String? @map("course_id")
  semesterId String? @map("semester_id")
  minPercent Float   @map("min_percent") // e.g. 95.0
  marks      Int // e.g. 5

  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@map("attendance_marks_configs")
}

// ─── Task ──────────────────────────────────────────────────
// Global task list, optionally linked to a course or project.
model Task {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  title       String
  notes       String?
  dueDate     DateTime?  @map("due_date")
  priority    Int        @default(2) // 1=high, 2=medium, 3=low, 4=lowest
  status      TaskStatus @default(open)
  courseId    String?    @map("course_id")
  projectId   String?    @map("project_id")
  domainId    String?    @map("domain_id")
  starred     Boolean    @default(false)
  completedAt DateTime?  @map("completed_at")
  // Energy sequencing fields
  energyRequirement String?  @map("energy_requirement") // low, medium, high
  estimatedDuration Int?     @map("estimated_duration") // minutes
  optimalTimeOfDay  String?  @map("optimal_time_of_day") // morning, afternoon, evening, any
  sortPriority      Float?   @map("sort_priority") // for energy-based task ordering (lower = higher priority)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  domain  Domain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  linkedNotes Note[]

  @@index([userId])
  @@map("tasks")
}

enum TaskStatus {
  open
  done
}

// ─── Note ──────────────────────────────────────────────────
// Quick notes, optionally linked to a course.
// Supports semantic linking via NoteLink for Second Brain features.
model Note {
  id                      String         @id @default(uuid())
  userId                  String?        @map("user_id")
  title                   String?
  content                 String
  sourceType              SourceType     @default(typed) @map("source_type")
  sourceLink              String?        @map("source_link") // OneDrive share link
  tags                    String[]       // free-form tags
  courseId                 String?        @map("course_id")
  taskId                   String?        @map("task_id")
  projectId                String?        @map("project_id")
  isDocumentLibraryEntry  Boolean        @default(false) @map("is_document_library_entry")
  folderId                String?        @map("folder_id")
  documentType            AttachmentType? @map("document_type")
  s3Key                   String?        @map("s3_key")
  s3Url                   String?        @map("s3_url")
  fileSize                Int?           @map("file_size")
  fileName                String?        @map("file_name")
  mimeType                String?        @map("mime_type")
  pageCount               Int?           @map("page_count")
  thumbnailUrl            String?        @map("thumbnail_url")
  originalUrl             String?        @map("original_url")
  embedHtml               String?        @map("embed_html")
  extractedText           String?        @map("extracted_text")
  lastViewedAt            DateTime?      @map("last_viewed_at")
  viewCount               Int            @default(0) @map("view_count")
  isPinned                Boolean        @default(false) @map("is_pinned")
  isFavorite              Boolean        @default(false) @map("is_favorite")
  lastReviewedAt          DateTime?      @map("last_reviewed_at") // spaced repetition tracking
  reviewCount             Int            @default(0) @map("review_count") // spaced repetition count
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  course           Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder           DocumentFolder?   @relation(fields: [folderId], references: [id])
  outgoingLinks    NoteLink[]        @relation("NoteLinks")
  incomingLinks    NoteLink[]        @relation("NoteBacklinks")
  noteAttachments  NoteAttachment[]
  annotations      NoteAnnotation[]

  @@index([userId])
  @@index([folderId])
  @@index([taskId])
  @@index([projectId])
  @@map("notes")
}

// ─── NoteLink ─────────────────────────────────────────────
// Semantic, explicit, and backlinks between notes.
// Powers the Second Brain knowledge graph.
model NoteLink {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  strength  Float    // 0-1 similarity score
  linkType  String   // semantic, explicit, backlink, reference
  createdAt DateTime @default(now())

  source Note @relation("NoteLinks", fields: [sourceId], references: [id], onDelete: Cascade)
  target Note @relation("NoteBacklinks", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@map("note_links")
}

// ─── Note Attachment ────────────────────────────────────────
// File attachments for notes (like email attachments).
// Used for notes with multiple file attachments.
model NoteAttachment {
  id            String         @id @default(cuid())
  noteId        String         @map("note_id")
  userId        String         @map("user_id")
  type          AttachmentType
  title         String
  s3Key         String         @map("s3_key")
  s3Url         String         @map("s3_url")
  fileSize      Int            @map("file_size")
  fileName      String         @map("file_name")
  mimeType      String         @map("mime_type")
  thumbnailUrl  String?        @map("thumbnail_url")
  pageCount     Int?           @map("page_count")
  extractedText String?        @map("extracted_text")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
  @@index([type])
  @@map("note_attachments")
}

// ─── Note Annotation ────────────────────────────────────────
// PDF annotations: highlights, notes, bookmarks, etc.
model NoteAnnotation {
  id               String   @id @default(cuid())
  noteId           String?  @map("note_id")
  fileAttachmentId String?  @map("file_attachment_id")
  userId           String   @map("user_id")
  type             String   // HIGHLIGHT, NOTE, BOOKMARK, UNDERLINE, STRIKEOUT
  pageNumber       Int      @map("page_number")
  position         Json     // stores boundingRect and rects for react-pdf-highlighter
  text             String?  // Highlighted text or note content
  color            String   @default("#FFD700")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  note           Note?           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileAttachment FileAttachment? @relation(fields: [fileAttachmentId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([fileAttachmentId])
  @@index([userId])
  @@index([pageNumber])
  @@map("note_annotations")
}

// ─── Document Folder ────────────────────────────────────────
// Folders for organizing document library entries within Notes.
model DocumentFolder {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  name        String
  description String?
  type        FolderType   @default(GENERAL)
  color       String?
  icon        String?
  parentId    String?      @map("parent_id")
  courseId     String?      @map("course_id")
  semesterId  String?      @map("semester_id")
  sortOrder   Int          @default(0) @map("sort_order")
  isPinned    Boolean      @default(false) @map("is_pinned")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent   DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children DocumentFolder[] @relation("FolderHierarchy")
  notes    Note[]
  course   Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester Semester?         @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([parentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([type])
  @@map("document_folders")
}

enum SourceType {
  typed
  ocr_photo
  voice
  uploaded_pdf
  uploaded_pptx
  uploaded_doc
}

enum AttachmentType {
  PDF
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  TEXT
  LINK
  OTHER
}

enum FolderType {
  PYQ
  RESOURCE_BOOK
  LECTURE_NOTE
  ASSIGNMENT
  REFERENCE
  PROJECT
  GENERAL
}

enum EventType {
  general
  birthday
  class
  assessment
}

// ─── Event ─────────────────────────────────────────────────
// Manually created events for the calendar.
model Event {
  id              String     @id @default(uuid())
  userId          String?    @map("user_id")
  title           String
  dateTime        DateTime   @map("date_time")
  endTime         DateTime?  @map("end_time")
  location        String?
  notes           String?
  eventType       EventType? @default(general) @map("event_type")
  // Recurring event support (iCal RRULE format)
  recurrenceRule  String?    @map("recurrence_rule") // e.g., "FREQ=WEEKLY;BYDAY=MO" for weekly on Monday
  recurrenceEnd   DateTime?  @map("recurrence_end") // When recurrence stops (null = forever)
  parentEventId   String?    @map("parent_event_id") // Link to parent event for instances
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@index([parentEventId])
  @@map("events")
}

// ─── Quote ─────────────────────────────────────────────────
// For the Library / Resurfacing feature.
model Quote {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  text      String
  source    String?
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("quotes")
}

// ─── Routine ───────────────────────────────────────────────
// Daily/weekly habits, separate from Tasks.
model Routine {
  id            String      @id @default(uuid())
  userId        String?     @map("user_id")
  name          String
  timeOfDay    TimeOfDay    @map("time_of_day")
  specificTime String?      @map("specific_time") // "HH:mm" format, nullable
  streakGoal   Int?         @map("streak_goal") // null = ongoing
  activeDays   DayOfWeek[]  @map("active_days") // which days it applies
  energyImpact EnergyImpact @default(neutral) @map("energy_impact")
  category     String?      @map("category") // deep_work, admin, creative, social, health, rest
  flowTrigger  String?      @map("flow_trigger") // e.g. "after_morning_coffee"
  identityId   String?      @map("identity_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  completions RoutineCompletion[]
  identity    Identity?    @relation(fields: [identityId], references: [id])

  @@index([userId])
  @@map("routines")
}

// ─── Routine Completion ────────────────────────────────────
// Tracks daily habit completions for streak calculation.
model RoutineCompletion {
  id          String   @id @default(uuid())
  routineId   String   @map("routine_id")
  date        DateTime @db.Date
  completedAt DateTime @default(now()) @map("completed_at")

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@map("routine_completions")
}

// ─── Identity ─────────────────────────────────────────────
// Identity-first habits: "I am a disciplined researcher".
// Routines reinforce identity, not just outcomes.
model Identity {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  statement   String         // "I am a disciplined researcher"
  description String?        // Optional elaboration
  status      IdentityStatus @default(aspirational)
  color       String?        // hex color for UI
  icon        String?        // lucide icon name
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  routines Routine[]

  @@index([userId])
  @@index([status])
  @@map("identities")
}

enum TimeOfDay {
  morning
  afternoon
  evening
  anytime
}

// ─── Push Subscription ──────────────────────────────────────
// Stores Web Push subscriptions for sending notifications.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Notification Preference ────────────────────────────────
// User preferences for notification types and daily summary.
model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  type                 String // 'routine_reminder' | 'task_due' | 'class_start' | 'assessment' | 'daily_summary' | 'missed_routine' | 'overdue_task'
  enabled              Boolean  @default(true)
  priority             String   @default("normal") // 'critical' | 'normal' | 'low'
  quietHoursStart      String?  @map("quiet_hours_start") // "HH:mm" e.g. "22:00"
  quietHoursEnd        String?  @map("quiet_hours_end") // "HH:mm" e.g. "07:00"
  dailySummaryTime     String?  @map("daily_summary_time") // "HH:mm" for daily summary (user's local time)
  dailySummarySections String[] @map("daily_summary_sections") // ['classes', 'tasks', 'routines', 'deadlines', 'attendance', 'tomorrow_classes']
  timezone             String? // IANA timezone identifier, e.g. "Asia/Kathmandu"

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

// ─── Sent Notification ──────────────────────────────────────
// Tracks which notifications have already been sent to prevent duplicates.
model SentNotification {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tag          String
  type         String    // NotificationType — e.g. 'class_start', 'task_due'
  sentAt       DateTime  @default(now()) @map("sent_at")
  openedAt     DateTime? @map("opened_at") // Set when user clicks the notification
  snoozedUntil DateTime? @map("snoozed_until") // Snooze until this time (stops repeated notifications)

  @@unique([userId, tag])
  @@index([userId])
  @@index([sentAt])
  @@index([type])
  @@map("sent_notifications")
}

// ─── Domain ───────────────────────────────────────────────
// Top-level life categories. Academics is implicit (Semester/Course structure).
// Non-academic domains (Personal, Finances, etc.) get explicit rows.
model Domain {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  name      String
  color     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]
  tasks    Task[]

  @@index([userId])
  @@map("domains")
}

// ─── Project ──────────────────────────────────────────────
// Non-academic projects (club work, personal builds, etc.).
model Project {
  id          String        @id @default(uuid())
  domainId    String        @map("domain_id")
  name        String
  description String?
  color       String?
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  domain     Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]
  linkedNotes Note[]

  @@map("projects")
}

enum ProjectStatus {
  active
  completed
  archived
}

// ─── Milestone ────────────────────────────────────────────
// Weighted milestones within a project, matching ref-07's pattern.
model Milestone {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  weight    Int // percentage weight for completion calculation
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

// ─── Budget Entry ─────────────────────────────────────────
// Simple income/expense tracking. No forecasting or envelopes in MVP.
model BudgetEntry {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  type      BudgetType
  amount    Decimal    @db.Decimal(10, 2)
  category  String
  date      DateTime   @db.Date
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId])
  @@map("budget_entries")
}

enum BudgetType {
  income
  expense
}

// ─── Insight Enums ─────────────────────────────────────────
enum InsightSeverity {
  info
  warning
  critical
  positive
}

enum InsightType {
  declining_skill
  burnout_risk
  missed_opportunity
  relationship_drift
  energy_mismatch
  budget_anomaly
  knowledge_gap
  focus_fragmentation
  achievement
  positive_trend
  streak_milestone
}

enum PatternType {
  procrastination_spike
  energy_crash
  social_isolation
  overspending
  learning_decay
  attendance_decline
  task_avoidance
}

enum EnergyImpact {
  charging
  draining
  neutral
}

enum IdentityStatus {
  aspirational
  developing
  integrated
  neglected
}

enum ReviewType {
  daily
  weekly
  monthly
  quarterly
}

enum ReviewStatus {
  generated
  viewed
  archived
}

// ─── Resource ─────────────────────────────────────────────
// Saved readings/links for the Library.
model Resource {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  title     String
  url       String?
  notes     String?
  tags      String[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("resources")
}

// ─── Person ───────────────────────────────────────────────
// Light CRM — name, birthday, freeform notes (facts + interactions).
model Person {
  id              String          @id @default(uuid())
  userId          String?         @map("user_id")
  name            String
  birthday         DateTime?    @db.Date
  notes            String? // freeform: facts, interaction log appended manually
  lastContact      DateTime?    @map("last_contact")
  contactFrequency String?      @map("contact_frequency") // daily, weekly, monthly, quarterly
  relationshipType String?      @map("relationship_type") // mentor, peer, family, network, colleague
  energyImpact     EnergyImpact @default(neutral) @map("energy_impact")
  importanceScore  Float?       @map("importance_score") // 0-1
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@map("people")
}

// ─── Google Calendar Token ──────────────────────────────────
// Stores OAuth tokens for Google Calendar read-only sync.
model GoogleCalendarToken {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId])
  @@index([userId])
  @@map("google_calendar_tokens")
}

// ─── AI Insights (deprecated — kept for data retention) ────
// Table preserved but no longer used by the application.
// Unified into ignored_insights via generateAIInsights().
model AiInsight {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  insights    String[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_insights")
  @@ignore
}

// ─── Widget Token ──────────────────────────────────────────
// API tokens for external callers (Tasker/KWGT widget).
// Single active token at a time — generating a new one revokes the old.
model WidgetToken {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  tokenHash    String    @map("token_hash") // SHA-256 hash, never store plaintext
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at") // updated on each successful widget API call
  revokedAt  DateTime? @map("revoked_at") // set when revoked

  @@index([userId])
  @@map("widget_tokens")
}

// ─── Ignored Insight ──────────────────────────────────────
// Insights the system generated but the user dismissed or ignored.
model IgnoredInsight {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  type        InsightType
  title       String
  description String
  severity    InsightSeverity
  evidence    Json? // supporting data points as JSON
  dismissedAt DateTime?       @map("dismissed_at")
  actedOn     Boolean         @default(false) @map("acted_on")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@index([actedOn, dismissedAt])
  @@map("ignored_insights")
}

// ─── Behavioral Pattern ───────────────────────────────────
// Detected recurring behavioral patterns (procrastination, energy crashes, etc.).
model BehavioralPattern {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  pattern    PatternType
  detectedAt DateTime        @map("detected_at")
  severity   InsightSeverity
  evidence   Json // supporting data points
  resolvedAt DateTime?       @map("resolved_at")
  resolution String? // how it was resolved
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([detectedAt])
  @@index([resolvedAt])
  @@map("behavioral_patterns")
}

// ─── Life Metric ──────────────────────────────────────────
// Quantified self data: sleep, mood, energy, social, creativity, focus, stress.
model LifeMetric {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  category   String // sleep, mood, energy, social, creativity, focus, stress
  value      Float
  recordedAt DateTime @map("recorded_at")
  source     String // manual, wearable, inferred, ai_detected
  confidence Float // 0-1, for inferred metrics
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, category])
  @@index([recordedAt])
  @@map("life_metrics")
}

// ─── Review ──────────────────────────────────────────────
// AI-generated reviews: daily briefs, weekly audits, monthly strategic reviews, quarterly vision checks.
model Review {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  type        ReviewType
  periodStart DateTime     @map("period_start")
  periodEnd   DateTime     @map("period_end")
  status      ReviewStatus @default(generated)
  summary     String // AI-generated executive summary
  sections    Json // structured report sections
  actions     Json // extracted action items
  metrics     Json // key metrics snapshot
  createdAt   DateTime     @default(now()) @map("created_at")
  viewedAt    DateTime?    @map("viewed_at")

  @@index([userId, type])
  @@index([periodEnd])
  @@index([status])
  @@map("reviews")
}

// ─── File Attachment ─────────────────────────────────────
// Files attached to semesters, courses, or notes.
model FileAttachment {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  contentType String   @map("content_type")
  key         String   // S3 object key
  url         String   // Public URL
  semesterId  String?  @map("semester_id")
  courseId     String?  @map("course_id")
  category    String?  // "syllabus" | "routine" | "calendar" | "other" (semester-level)
  tags        String[] // Freeform tags (course-level)
  description String?
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  annotations NoteAnnotation[]

  @@index([userId])
  @@index([semesterId])
  @@index([courseId])
  @@map("file_attachments")
}

// ─── User Dashboard Preference ──────────────────────────────
// Per-user settings for Today page widget layout, accent color, and theme.
model UserDashboardPreference {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  widgetOrder     Json     @default("[]") @map("widget_order")    // Ordered array of widget IDs
  hiddenWidgets   String[] @default([]) @map("hidden_widgets")     // Widget IDs the user hid
  accentColor     String?  @map("accent_color")                    // Hex color or null (default)
  themeMode       String   @default("light") @map("theme_mode")   // "light" | "dark" | "system"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId])
  @@map("user_dashboard_preferences")
}

// ═════════════════════════════════════════════════════════════
// DSA PROGRESS TRACKER (ADDITIVE MODULE)
// ═════════════════════════════════════════════════════════════

enum DsaTopicStatus {
  not_started
  in_progress
  practised
  needs_revision
  comfortable
}

enum DsaDifficulty {
  easy
  medium
  hard
}

enum DsaClassification {
  independent
  effortful
  hinted
  editorial
  not_understood
}

enum DsaHelpType {
  none
  small_hint
  big_hint
  editorial
  tutor
  other
}

enum DsaContestPlatform {
  leetcode
  codechef
  other
}

model DsaSettings {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  programmeStartDate  DateTime  @db.Date @map("programme_start_date")
  programmeLengthDays Int       @default(90) @map("programme_length_days")
  phases              Json      @default("[]")
  currentTopicId      String?   @map("current_topic_id")
  lastBackupAt        DateTime? @map("last_backup_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("dsa_settings")
}

model DsaTopic {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  name      String
  order     Int
  status    DsaTopicStatus @default(not_started)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  problems DsaProblem[]

  @@unique([userId, name])
  @@index([userId, order])
  @@map("dsa_topics")
}

model DsaProblem {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  topicId      String         @map("topic_id")
  subtopic     String         @default("")
  title        String
  difficulty   DsaDifficulty?
  sourceUrl    String         @default("") @map("source_url")
  platform     String         @default("")
  platformId   String?        @map("platform_id")
  orderInTopic Int            @default(0) @map("order_in_topic")
  tags         String[]       @default([])
  importKey    String         @map("import_key")
  archived     Boolean        @default(false)

  // Personal-progress cache columns (imports NEVER overwrite)
  lastClassification     DsaClassification? @map("last_classification")
  lastAttemptAt          DateTime?          @map("last_attempt_at")
  intervalDays           Int?               @map("interval_days")
  consecutiveIndependent Int                @default(0) @map("consecutive_independent")
  nextRevisionDate       DateTime?          @db.Date @map("next_revision_date")
  manualNextRevisionDate DateTime?          @db.Date @map("manual_next_revision_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topic    DsaTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts DsaAttempt[]

  @@unique([userId, importKey])
  @@index([userId, topicId, orderInTopic])
  @@index([userId, nextRevisionDate])
  @@map("dsa_problems")
}

model DsaAttempt {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  problemId       String            @map("problem_id")
  attemptedAt     DateTime          @default(now()) @map("attempted_at")
  attemptDate     DateTime          @db.Date @map("attempt_date")
  classification  DsaClassification
  timeSpentMin    Int               @map("time_spent_min")
  confidence      Int
  isRevision      Boolean           @default(false) @map("is_revision")
  helpType        DsaHelpType       @default(none) @map("help_type")
  initialApproach String?           @map("initial_approach")
  finalApproach   String?           @map("final_approach")
  mistakes        String?
  mistakeTags     String[]          @default([]) @map("mistake_tags")
  timeComplexity  String?           @map("time_complexity")
  spaceComplexity String?           @map("space_complexity")
  observation     String?
  sessionId       String?           @map("session_id")
  clientRequestId String?           @map("client_request_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  problem DsaProblem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  session DsaSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, problemId, attemptedAt])
  @@index([userId, attemptDate])
  @@index([sessionId])
  @@map("dsa_attempts")
}

model DsaSession {
  id                         String   @id @default(uuid())
  userId                     String   @map("user_id")
  date                       DateTime @db.Date
  durationMin                Int?     @map("duration_min")
  observations               String?
  nextSessionAvailabilityMin Int?     @map("next_session_availability_min")
  nextSessionNote            String?  @map("next_session_note")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  attempts DsaAttempt[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("dsa_sessions")
}

model DsaContest {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  platform          DsaContestPlatform
  name              String
  date              DateTime           @db.Date
  problemsAttempted Int                @map("problems_attempted")
  problemsSolved    Int                @map("problems_solved")
  rankOrRating      String?            @map("rank_or_rating")
  upsolveProblems   String?            @map("upsolve_problems")
  conceptsMissed    String?            @map("concepts_missed")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("dsa_contests")
}
// ─── End DSA Progress Tracker ───────────────────────────────
